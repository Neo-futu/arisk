AUTORISK_SERVICE_NAME=AutoRisk
AUTORISK_API_PREFIX=/api/v1
AUTORISK_WORKFLOW_MODE=FULL_AI
# Local demonstration values only. Replace both values before deployment.
AUTORISK_API_KEYS=autorisk-dev-key
AUTORISK_SIGNING_SECRET=change-this-development-signing-secret
AUTORISK_CORS_ORIGINS=*
AUTORISK_AI_REVIEW_ENABLED=true
AUTORISK_AI_PROVIDER=deterministic
# Optional OpenAI-compatible provider for reasoning text only; deterministic rules remain authoritative.
AUTORISK_LLM_BASE_URL=
AUTORISK_LLM_API_KEY=
AUTORISK_LLM_MODEL=
AUTORISK_LLM_TIMEOUT_SECONDS=20
AUTORISK_CALLBACK_ENABLED=false
AUTORISK_FIRST_SIGNER=ai-risk-officer
AUTORISK_SECOND_SIGNER=ai-mic
# Final conclusion certificate validity window and independent feedback receipt storage.
AUTORISK_CONCLUSION_VALIDITY_MINUTES=60
AUTORISK_FEEDBACK_PATH=./data/feedback_receipts.json
