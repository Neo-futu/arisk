# 复制为 backend.dev.hcl（已 .gitignore），把 <app-name> 换成你的 app_name。
# 用法：tofu init -backend-config=backend.dev.hcl
bucket         = "balance-tf-state-dev-ap-east-1"
key            = "app/arisk/dev/terraform.tfstate"
workspace_key_prefix = "app/arisk/dev/workspaces"
region         = "ap-east-1"
dynamodb_table = "balance-tf-locks-dev-ap-east-1"
encrypt        = true
