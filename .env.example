# ── Database ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fsi_risk
POSTGRES_USER=fsi_user
POSTGRES_PASSWORD=change_me

TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=fsi_timeseries

REDIS_URL=redis://localhost:6379/0

# ── Object Store (S3 / MinIO) ──────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fsi-risk-artefacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me

# ── WindAPI ────────────────────────────────────────────────────
WIND_USERNAME=
WIND_PASSWORD=

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Processing API ────────────────────────────────────────────
PROCESSING_API_URL=http://localhost:8001
PROCESSING_API_KEY=internal_key_change_me

# ── MCP Gateway ───────────────────────────────────────────────
MCP_GATEWAY_PORT=8002
MCP_GATEWAY_SECRET=change_me

# ── Entry Web App ─────────────────────────────────────────────
WEB_PORT=8000
WEB_SECRET_KEY=change_me
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Celery / Task Queue ───────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Environment ───────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
