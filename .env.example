# ── Database ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fsi_risk
POSTGRES_USER=fsi_user
POSTGRES_PASSWORD=change_me

TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=fsi_timeseries

REDIS_URL=redis://localhost:6379/0

# ── Object Store (S3 / MinIO) ──────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fsi-risk-artefacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me

# ── WindAPI ────────────────────────────────────────────────────
WIND_USERNAME=
WIND_PASSWORD=

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Processing API ────────────────────────────────────────────
PROCESSING_API_URL=http://localhost:8001
PROCESSING_API_KEY=internal_key_change_me

# ── Backend / User API Keys ───────────────────────────────────
# 本地腳本使用的用戶 API Key 請登入 Web UI → API Key 管理建立；
# 不要把 PROCESSING_API_KEY 複製到瀏覽器或用戶腳本。
BACKEND_PUBLIC_URL=http://localhost:8000

# ── Notifications ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=ARISK
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

# ── MCP Gateway ───────────────────────────────────────────────
MCP_GATEWAY_PORT=8002
MCP_GATEWAY_SECRET=change_me

# ── Entry Web App ─────────────────────────────────────────────
WEB_PORT=8000
WEB_SECRET_KEY=change_me
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Celery / Task Queue ───────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Environment ───────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
